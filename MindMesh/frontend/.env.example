# MindMesh Frontend — Environment Variable Template
# Copy this file to .env.local for local development.
# Never commit real secrets. Vite only exposes variables prefixed with VITE_.

# Base URL of the backend API (versioned per ARCHITECTURE.md Section 6)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Request timeout for the Axios client, in milliseconds
VITE_API_TIMEOUT_MS=15000

# Google OAuth client ID (used by the future auth flow — Milestone 2)
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Application environment: development | staging | production
VITE_APP_ENV=development
