# MindMesh Frontend — Docker image
# Milestone 1: development-friendly build. A dedicated production build
# (static export served via CDN/Vercel) is finalized in Milestone 12.

FROM node:20-alpine AS base

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host"]
