# MindMesh Backend — Environment Variable Template
# Copy this file to backend/.env for local development.
# Never commit real secrets. Separate secrets per environment (ARCHITECTURE.md Section 10).

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-every-environment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL — system of record, ARCHITECTURE.md Section 4)
DATABASE_URL=postgres://mindmesh:mindmesh@db:5432/mindmesh

# Redis (cache + Celery broker, ARCHITECTURE.md Section 8)
REDIS_URL=redis://redis:6379/0

# CORS — strict allow-list (ARCHITECTURE.md Section 10)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend URL — used to build links (e.g. the password reset email link)
FRONTEND_URL=http://localhost:5173

# Email (password reset notifications). Defaults to the console backend
# (prints emails to the server log) when unset — no SMTP credentials
# required for local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=MindMesh <no-reply@mindmesh.app>

# Google OAuth — the frontend Google Identity Services flow sends a Google
# ID token to the backend, which verifies it directly against Google using
# this client ID. No client secret is needed for this flow.
GOOGLE_OAUTH_CLIENT_ID=

# AI Provider Abstraction Layer (ARCHITECTURE.md Section 7). Brought forward
# minimally in Milestone 6 to power Notes' AI summaries; the full chat/
# memory surface is built out in Milestones 7-8. Defaults to the offline
# `stub` provider (no key required) — set AI_PROVIDER=gemini or
# AI_PROVIDER=openai once a key below is supplied.
AI_PROVIDER=stub
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_SUMMARY_TIMEOUT_SECONDS=15

# Notes attachments (Milestone 6) — max upload size in bytes.
NOTE_ATTACHMENT_MAX_SIZE_BYTES=10485760

# Push notification provider (Milestone 9 — Notifications). Defaults to the
# offline `console` adapter (logs instead of calling a real vendor, no
# credentials required) — point at a real adapter once FCM/APNs/Web Push
# credentials are available.
PUSH_PROVIDER=console

# Enables tests to run Celery tasks synchronously in-process without a
# running broker. Leave unset/False outside of the test environment.
CELERY_TASK_ALWAYS_EAGER=False

# --------------------------------------------------------------------------
# Milestone 12 — Production & Deployment
# --------------------------------------------------------------------------

# Auth cookie settings (ADR 0001 — docs/adr/0001-token-storage-strategy.md).
# Defaults shown below are correct for local dev (same-site localhost) and
# rarely need overriding there. In production, config/settings/production.py
# forces AUTH_COOKIE_SECURE=True and defaults AUTH_COOKIE_SAMESITE to
# 'None' (required for the cross-origin Vercel <-> Railway split) —
# override AUTH_COOKIE_SAMESITE only if frontend and backend end up on the
# same registrable domain.
AUTH_REFRESH_COOKIE_NAME=mm_refresh
AUTH_CSRF_COOKIE_NAME=mm_csrf
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=

# Trusted origins for Django's own CSRF machinery, used by the
# session-authenticated admin site (not the JWT API, which uses the
# double-submit cookie above). REQUIRED in production — see
# config/settings/production.py, which refuses to start without it.
CSRF_TRUSTED_ORIGINS=

# TLS/HSTS (production.py only; safe to leave unset in development).
# Railway terminates TLS at its edge and forwards plain HTTP internally, so
# SECURE_SSL_REDIRECT relies on the X-Forwarded-Proto header rather than
# request.scheme — already wired in production.py's SECURE_PROXY_SSL_HEADER.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Structured logging level (config/settings/base.py LOGGING). INFO in
# production; DEBUG locally only if you need Django's own query/request
# tracing.
DJANGO_LOG_LEVEL=INFO

# gunicorn worker count in production (infra/docker/Dockerfile.backend,
# backend/railway.json). Railway sets this automatically based on the
# instance's CPU allocation; override only if you need to tune it manually.
WEB_CONCURRENCY=3

# Toggles a minimal built-in static-file serve route in config/urls.py for
# platforms without an Nginx/CDN in front of Django (e.g. Railway serving
# the admin's CSS/JS directly). Self-hosted deployments fronted by the
# Nginx config in infra/nginx/nginx.prod.conf should leave this off and let
# Nginx serve /static/ instead.
DJANGO_SERVE_STATIC=True
